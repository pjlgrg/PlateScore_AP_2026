digraph ER {
graph [rankdir=LR, bgcolor="white", pad="0.4", nodesep="0.65", ranksep="1.2", splines=polyline, dpi=130, fontname="Helvetica", fontsize=20, labelloc=t, label="PlateScore | Rishihood University mess (BCH) | T0133"];
node [shape=plain, fontname="Helvetica"];
edge [fontname="Helvetica", fontsize=10, color="#475569", arrowsize=0.8, labeldistance=1.8];
dishes [label=<<TABLE BORDER="1" COLOR="#64748b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><B>dishes</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">dish_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">dish_name</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">description ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(300)</FONT></TD></TR></TABLE>>];
meals [label=<<TABLE BORDER="1" COLOR="#64748b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><B>meals</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">meal_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">UK1</TD><TD ALIGN="LEFT">meal_type</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT">UK1</TD><TD ALIGN="LEFT">meal_date</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">date</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">published_by</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_published</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">boolean</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="11">UK1 = (meal_type, meal_date)</FONT></TD></TR></TABLE>>];
menu_items [label=<<TABLE BORDER="1" COLOR="#64748b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><B>menu_items</B></TD></TR><TR><TD ALIGN="LEFT">PK,FK</TD><TD ALIGN="LEFT">meal_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">PK,FK</TD><TD ALIGN="LEFT">dish_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR></TABLE>>];
ratings [label=<<TABLE BORDER="1" COLOR="#64748b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><B>ratings</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">rating_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">FK,UK2</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">FK,UK2</TD><TD ALIGN="LEFT">meal_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">score</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">comment ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(300)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">rated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="11">UK2 = (user_id, meal_id)</FONT></TD></TR></TABLE>>];
users [label=<<TABLE BORDER="1" COLOR="#64748b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><B>users</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(254)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamptz</FONT></TD></TR></TABLE>>];
users -> meals [dir=both, arrowtail=tee, arrowhead=ocrow, taillabel="1", headlabel="0..N", label="publishes"];
users -> ratings [dir=both, arrowtail=tee, arrowhead=ocrow, taillabel="1", headlabel="0..N", label="writes"];
meals -> ratings [dir=both, arrowtail=tee, arrowhead=ocrow, taillabel="1", headlabel="0..N", label="receives"];
meals -> menu_items [dir=both, arrowtail=tee, arrowhead=ocrow, taillabel="1", headlabel="0..N", label="contains"];
dishes -> menu_items [dir=both, arrowtail=tee, arrowhead=ocrow, taillabel="1", headlabel="0..N", label="served in"];
legend [label="PK = primary key    FK = foreign key    UK = unique key
A composite key uses the listed columns together.    ? = nullable", shape=box, color="#94a3b8", fontsize=11];
}
